{
  "name": "opc-os",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0"
  },
  "scripts": {
    "dev": "tsx packages/hub/src/serve/dev-entry.ts",
    "dev:seed": "tsx packages/hub/src/serve/dev-seed.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "biome check .",
    "tw:build": "tailwindcss -i packages/web/styles/tw-input.css -o packages/web/public/tw.css --minify",
    "tw:watch": "tailwindcss -i packages/web/styles/tw-input.css -o packages/web/public/tw.css --watch",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json --noEmit",
    "verify": "pnpm lint && pnpm typecheck && pnpm test",
    "migrate": "tsx packages/hub/src/db/migrate-cli.ts",
    "hub": "tsx packages/hub/src/cli.ts",
    "hub:serve": "tsx packages/hub/src/serve/hub-serve.ts",
    "hub:engine": "tsx packages/hub/src/engine/hub-work.ts",
    "hub:charter": "tsx packages/hub/src/charter/seed.ts",
    "hub:maintenance": "tsx packages/hub/src/heartbeat/maintenance.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@langchain/langgraph": "^1.7.1",
    "@langchain/langgraph-checkpoint": "^1.2.2",
    "@langchain/langgraph-checkpoint-sqlite": "^1.1.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/cli": "^4.3.5",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "4.1.12",
    "playwright": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "_comment": "保留，不是遗留：PoC（packages/hub/src/poc/*.mjs、test/poc/resume.test.ts）与 Phase 0 证据脚本 用官方 SqliteSaver 验证 LangGraph 的 Checkpoint 语义，它依赖 better-sqlite3。原计划「0.4b 自研 Saver 落地后即移除本项」经实测证伪——移除会让 test/poc/resume.test.ts 的 8 条门禁测试当场失败。「生产代码零原生模块」这条 D6 判据改由 test/arch/no-native-deps.test.ts 扫 packages/** 强制（PoC 目录显式豁免并写明理由）。它们不进 dist、也不进 Electron 产物。见计划 §1 V21。"
  }
}
